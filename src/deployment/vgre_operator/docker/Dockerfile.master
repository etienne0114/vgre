# VGRE Master Container Image
#
# Builds the VGRE runtime library and dashboard from source,
# producing a container that runs vgre-start --master on startup.
#
# Build context: the repository root (virtual-gpu-runtime/)
#
# Usage:
#   docker build -f src/deployment/vgre_operator/docker/Dockerfile.master -t vgre-master:latest .
#
# Required environment variables (injected by the VGRE Operator):
#   VGRE_TCP_AUTH_TOKEN  — HMAC-SHA256 cluster authentication token
#   VGRE_PORT            — TCP control port (default: 7777)
#   VGRE_SHM_SUFFIX      — Shared memory namespace suffix for cluster isolation

FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build git \
    llvm-18-dev libclang-18-dev libomp-18-dev \
    libssl-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY . .

RUN cmake -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DVGRE_BUILD_TESTS=OFF \
    -DVGRE_BUILD_DASHBOARD=OFF \
    && cmake --build build --parallel

FROM ubuntu:22.04
RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 libomp-18 libstdc++6 libgcc-s1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/build/libvgre*.so* /usr/local/lib/
COPY --from=builder /build/build/vgre-worker /usr/local/bin/
RUN ldconfig

# The master runs vgre-worker in headless master mode.
# --is-master tells the worker to call cluster.initialize(true, "", port)
# so it acts as the cluster coordinator, listening for incoming worker connections.
# VGRE_PORT and VGRE_TCP_AUTH_TOKEN are injected by the VGRE Operator.
EXPOSE 7777/tcp 7778/udp

ENTRYPOINT ["/usr/local/bin/vgre-worker", "--is-master"]
